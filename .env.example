# Frontend Environment Variables
# These are automatically set in docker-compose.yml
# Only needed if running frontend outside Docker

# The base every browser-side API URL starts with. Absolute here, because the
# Vite dev server has no nginx in front of it; the appliance sets the relative
# /api (docker-compose.pi.yml), which nginx proxies to the backend on the
# page's own origin.
PUBLIC_API_BASE=http://localhost:8000
# Server-side rendering runs in Node and needs an absolute URL.
PUBLIC_API_BASE_SSR=http://localhost:8000
